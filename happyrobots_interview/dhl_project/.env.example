# =============================================================================
#  DHL AI COMMAND CENTER — Environment / API Keys
# =============================================================================
#  Copy this file to ".env" and fill in your real keys.
#  NEVER commit the real ".env" — only this ".env.example" template.
#
#  HOW n8n USES THESE:
#  - For most nodes, you paste the key into n8n's Credentials UI (recommended).
#  - You can also reference any var below inside a node as:  {{ $env.VARNAME }}
#  - If self-hosting n8n with Docker, these load automatically from .env
# =============================================================================


# -----------------------------------------------------------------------------
#  TIER 1 — REQUIRED FOR THE DEMO  (this is the ONLY key you must have)
# -----------------------------------------------------------------------------

# OpenAI — powers the GPT Brain (the router + all 5 agents)
# Get it: https://platform.openai.com/api-keys
# Cost: pay-as-you-go; gpt-4o-mini is extremely cheap (~$0.15 / 1M input tokens)
# REQUIRED: YES
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
#  TIER 2 — REAL TRACKING DATA  (optional — demo uses mock data without it)
# -----------------------------------------------------------------------------

# DHL Unified Tracking API — live shipment status instead of mock data
# Get it: https://developer.dhl.com (free tier available; create an app)
# Unlocks: the track_shipment tool calls the real DHL API
# REQUIRED: NO (mock data works for the demo)
DHL_API_KEY=


# -----------------------------------------------------------------------------
#  TIER 3 — REAL CHANNELS: VOICE, SMS, WHATSAPP  (optional — for omnichannel)
# -----------------------------------------------------------------------------

# Twilio — powers Voice (speech-to-text + text-to-speech), SMS, and WhatsApp
# Get it: https://www.twilio.com/console  (free trial with credit)
# Unlocks: customers reach the agent by phone call, SMS, or WhatsApp
# REQUIRED: NO (chat works without it)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886


# -----------------------------------------------------------------------------
#  TIER 4 — REAL CHANNEL: EMAIL  (optional — pick ONE of the two)
# -----------------------------------------------------------------------------

# Option A: SendGrid (easiest for sending) — https://sendgrid.com
SENDGRID_API_KEY=

# Option B: Plain SMTP (e.g. Gmail app password, Outlook, company mail server)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here


# -----------------------------------------------------------------------------
#  TIER 5 — OPTIONAL EXTRAS
# -----------------------------------------------------------------------------

# Anthropic (Claude) — optional alternative LLM if you want to swap the brain
# Get it: https://console.anthropic.com
# REQUIRED: NO
ANTHROPIC_API_KEY=

# A shared secret to protect your incoming webhook (recommended for production)
# You invent this value yourself; the channel gateway must send it back.
WEBHOOK_SHARED_SECRET=change-me-to-a-long-random-string


# -----------------------------------------------------------------------------
#  TIER 6 — n8n SELF-HOSTING CONFIG  (only if you run n8n via Docker yourself)
# -----------------------------------------------------------------------------

# n8n encrypts stored credentials with this key — keep it safe and constant
N8N_ENCRYPTION_KEY=generate-a-long-random-string-once
# Base URL n8n uses to build webhook links (set to your public URL in prod)
WEBHOOK_URL=http://localhost:5678/
